# Copy this file to .env.local for local development.
# In Vercel: add these under Project → Settings → Environment Variables.

# Your Anthropic API key (never expose this in the frontend)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Restrict CORS to your Kajabi site domain (recommended for production)
# Example: https://yoursite.mykajabi.com or https://www.yourdomain.com
# Use * to allow all origins (OK for development, not ideal for production)
ALLOWED_ORIGIN=https://yoursite.mykajabi.com
